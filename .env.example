# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/moscollector
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_PUBLIC_REGISTRATION=true
FORCE_HTTPS=false

# PostgreSQL (docker-compose example values)
POSTGRES_DB=moscollector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
